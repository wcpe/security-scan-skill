{
  "version": 1,
  "description": "security-scan 预筛规则库。规则只负责定位候选点，不做判定；命中不等于漏洞。kind: source(不可信入口) / sink(危险汇聚点) / sanitizer(净化或安全写法) / secret(疑似硬编码凭据) / config(不安全配置)。l1=true 的规则参与 L1 快检（要求高置信、低噪声）。",
  "rules": [
    { "id": "any-secret-aws-akid", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "high", "l1": true, "pattern": "\\bAKIA[0-9A-Z]{16}\\b", "note": "AWS Access Key ID 形态" },
    { "id": "any-secret-private-key", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "critical", "l1": true, "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----", "note": "私钥 PEM 块直接落在源码里" },
    { "id": "any-secret-github-token", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "high", "l1": true, "pattern": "\\bgh[pousr]_[A-Za-z0-9]{30,}\\b", "note": "GitHub token 形态" },
    { "id": "any-secret-slack-token", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "high", "l1": true, "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}", "note": "Slack token 形态" },
    { "id": "any-secret-google-key", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "high", "l1": true, "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b", "note": "Google API Key 形态" },
    { "id": "any-secret-stripe-live", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "critical", "l1": true, "pattern": "\\bsk_live_[0-9a-zA-Z]{16,}", "note": "Stripe 生产密钥" },
    { "id": "any-secret-jwt", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "medium", "l1": false, "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}", "note": "写死的 JWT，注意可能只是测试样例" },
    { "id": "any-secret-conn-string", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "high", "l1": true, "pattern": "(?i)\\b(?:mongodb(?:\\+srv)?|mysql|postgres(?:ql)?|redis|amqp|ftp)://[^:\\s\"'/]+:[^@\\s\"']+@", "note": "连接串里带明文口令" },
    { "id": "any-secret-assignment", "lang": ["any"], "kind": "secret", "category": "hardcoded-secret", "cwe": "CWE-798", "severity_hint": "medium", "l1": false, "pattern": "(?i)\\b(?:password|passwd|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|client[_-]?secret|auth[_-]?token)\\s*[:=]\\s*[\"'][^\"'\\s]{8,}[\"']", "exclude": "(?i)(example|sample|placeholder|your[_-]?|xxx|\\*{3}|<[^>]+>|\\$\\{|%s|\\{\\{|changeme|dummy|fake|redacted|todo|null|none|env\\.|process\\.env|os\\.getenv|getenv\\(|System\\.getenv|Environment\\.Get)", "note": "疑似硬编码凭据；先确认不是占位符或测试常量" },
    { "id": "any-crypto-weak-mode", "lang": ["any"], "kind": "sink", "category": "weak-crypto", "cwe": "CWE-327", "severity_hint": "medium", "l1": false, "pattern": "[\"'](?:DES|DESede|RC4|Blowfish|AES/ECB|AES-\\d+-ECB)[\"'/]", "note": "弱算法或 ECB 模式" },
    { "id": "any-cors-wildcard-origin", "lang": ["any"], "kind": "config", "category": "cors-misconfig", "cwe": "CWE-942", "severity_hint": "medium", "l1": false, "pattern": "Access-Control-Allow-Origin[\"']?\\s*[,:=]\\s*[\"']\\*", "note": "通配 Origin；若同时允许携带凭据则危险" },

    { "id": "py-src-flask-request", "lang": ["python"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\brequest\\.(?:args|form|json|values|data|files|cookies|headers|get_json)\\b", "note": "Flask 请求入口" },
    { "id": "py-src-django-request", "lang": ["python"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\brequest\\.(?:GET|POST|FILES|COOKIES|META|body)\\b", "note": "Django 请求入口" },
    { "id": "py-src-fastapi-param", "lang": ["python"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\b(?:Query|Body|Path|Form|Header|Cookie|File|UploadFile)\\s*\\(", "note": "FastAPI 参数声明" },
    { "id": "py-src-cli-env", "lang": ["python"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\b(?:sys\\.argv|os\\.environ|os\\.getenv|input)\\s*[\\[(]", "note": "命令行 / 环境变量 / 交互输入；信任等级取决于部署形态" },
    { "id": "py-sink-shell-true", "lang": ["python"], "kind": "sink", "category": "command-injection", "cwe": "CWE-78", "severity_hint": "high", "l1": true, "pattern": "subprocess\\.[A-Za-z_]+\\s*\\([^)]*shell\\s*=\\s*True", "note": "shell=True，参数会被 shell 解释" },
    { "id": "py-sink-os-system", "lang": ["python"], "kind": "sink", "category": "command-injection", "cwe": "CWE-78", "severity_hint": "high", "l1": true, "pattern": "\\bos\\.(?:system|popen|execl?p?e?|spawn\\w*)\\s*\\(", "note": "直接交给 shell / exec 族" },
    { "id": "py-sink-subprocess", "lang": ["python"], "kind": "sink", "category": "command-injection", "cwe": "CWE-78", "severity_hint": "medium", "l1": false, "pattern": "\\bsubprocess\\.(?:run|call|check_call|check_output|Popen)\\s*\\(", "note": "列表形式且无 shell=True 时通常安全，确认参数构造方式" },
    { "id": "py-sink-eval-exec", "lang": ["python"], "kind": "sink", "category": "code-injection", "cwe": "CWE-94", "severity_hint": "critical", "l1": true, "pattern": "(?:^|[^\\w.])(?:eval|exec)\\s*\\(", "note": "动态求值；参数只要沾到外部输入即为代码注入" },
    { "id": "py-sink-pickle", "lang": ["python"], "kind": "sink", "category": "deserialization", "cwe": "CWE-502", "severity_hint": "critical", "l1": true, "pattern": "\\b(?:pickle|cPickle|dill|jsonpickle|marshal)\\.(?:load|loads|decode)\\s*\\(", "note": "反序列化任意对象，等价于任意代码执行" },
    { "id": "py-sink-yaml-load", "lang": ["python"], "kind": "sink", "category": "deserialization", "cwe": "CWE-502", "severity_hint": "high", "l1": true, "pattern": "\\byaml\\.(?:load|unsafe_load|full_load)\\s*\\(", "note": "非 SafeLoader 的 yaml.load 可实例化任意对象；确认 Loader 参数" },
    { "id": "py-sink-sql-fstring", "lang": ["python"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "high", "l1": true, "pattern": "\\.(?:execute|executemany|executescript|raw)\\s*\\(\\s*f[\"']", "note": "f-string 直接拼进 SQL" },
    { "id": "py-sink-sql-concat", "lang": ["python"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "high", "l1": false, "pattern": "\\.(?:execute|executemany|executescript|raw)\\s*\\([^)]*(?:%\\s*[\\(\\w]|\\.format\\s*\\(|\\+\\s*\\w)", "note": "字符串格式化 / 拼接进 SQL" },
    { "id": "py-sink-django-extra", "lang": ["python"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "medium", "l1": false, "pattern": "\\.(?:extra|annotate)\\s*\\([^)]*(?:select|where|tables)\\s*=", "note": "Django extra() 原样拼 SQL" },
    { "id": "py-sink-http-request", "lang": ["python"], "kind": "sink", "category": "ssrf", "cwe": "CWE-918", "severity_hint": "medium", "l1": false, "pattern": "\\b(?:requests|httpx)\\.(?:get|post|put|patch|delete|head|request)\\s*\\(|urllib\\.request\\.urlopen\\s*\\(|aiohttp\\.ClientSession", "note": "服务端出网；URL 可控且未限定协议/网段时构成 SSRF" },
    { "id": "py-sink-file-dynamic", "lang": ["python"], "kind": "sink", "category": "path-traversal", "cwe": "CWE-22", "severity_hint": "medium", "l1": false, "pattern": "\\b(?:open|os\\.remove|os\\.unlink|os\\.rename|shutil\\.(?:copy\\w*|move|rmtree))\\s*\\([^)]*(?:\\+|%|\\.format\\s*\\(|f[\"']|os\\.path\\.join)", "note": "路径由拼接得来" },
    { "id": "py-sink-send-file", "lang": ["python"], "kind": "sink", "category": "path-traversal", "cwe": "CWE-22", "severity_hint": "high", "l1": false, "pattern": "\\b(?:send_file|send_from_directory|FileResponse|serve)\\s*\\(", "note": "按路径回吐文件" },
    { "id": "py-sink-extractall", "lang": ["python"], "kind": "sink", "category": "path-traversal", "cwe": "CWE-22", "severity_hint": "high", "l1": true, "pattern": "\\.extractall\\s*\\(|\\bshutil\\.unpack_archive\\s*\\(", "note": "Zip Slip：压缩包内条目名可含 ../" },
    { "id": "py-sink-ssti", "lang": ["python"], "kind": "sink", "category": "template-injection", "cwe": "CWE-1336", "severity_hint": "critical", "l1": true, "pattern": "\\b(?:render_template_string|Template)\\s*\\(", "note": "模板内容可控即为 SSTI，Jinja2 可直接逃逸到 RCE" },
    { "id": "py-sink-xml", "lang": ["python"], "kind": "sink", "category": "xxe", "cwe": "CWE-611", "severity_hint": "medium", "l1": false, "pattern": "\\b(?:etree\\.(?:parse|fromstring|XML)|minidom\\.parse\\w*|sax\\.parse|pulldom\\.parse)\\s*\\(", "note": "确认是否禁用了外部实体；标准库 lxml 需显式配置" },
    { "id": "py-sink-weak-hash", "lang": ["python"], "kind": "sink", "category": "weak-crypto", "cwe": "CWE-327", "severity_hint": "low", "l1": false, "pattern": "hashlib\\.(?:md5|sha1)\\s*\\(", "note": "用于口令或签名时不可接受；用作非安全用途的校验和则无碍" },
    { "id": "py-sink-weak-random", "lang": ["python"], "kind": "sink", "category": "weak-random", "cwe": "CWE-338", "severity_hint": "low", "l1": false, "pattern": "\\brandom\\.(?:random|randint|randrange|choice|choices|sample|shuffle)\\s*\\(", "note": "生成 token / 口令 / 会话标识时不可用，应换 secrets" },
    { "id": "py-cfg-verify-false", "lang": ["python"], "kind": "config", "category": "insecure-tls", "cwe": "CWE-295", "severity_hint": "high", "l1": true, "pattern": "verify\\s*=\\s*False|_create_unverified_context\\s*\\(|CERT_NONE", "note": "关闭 TLS 校验" },
    { "id": "py-san-shlex", "lang": ["python"], "kind": "sanitizer", "category": "", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\bshlex\\.(?:quote|split)\\s*\\(", "note": "shell 参数转义" },
    { "id": "py-san-path", "lang": ["python"], "kind": "sanitizer", "category": "", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "os\\.path\\.(?:realpath|abspath)\\s*\\(|\\.resolve\\s*\\(\\s*\\)|secure_filename\\s*\\(", "note": "路径规范化；仍需配合归属前缀判断" },
    { "id": "py-san-misc", "lang": ["python"], "kind": "sanitizer", "category": "", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\b(?:yaml\\.safe_load|html\\.escape|defusedxml|secrets\\.(?:token_\\w+|choice|randbelow))\\s*[\\.(]", "note": "安全替代实现" },

    { "id": "js-src-req", "lang": ["javascript", "typescript"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\b(?:req|ctx|request)\\.(?:query|body|params|headers|cookies|files)\\b", "note": "HTTP 请求入口" },
    { "id": "js-src-dom", "lang": ["javascript", "typescript"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\b(?:location\\.(?:href|search|hash|pathname)|document\\.(?:URL|referrer|cookie)|window\\.name|event\\.data|searchParams\\.get)\\b", "note": "浏览器侧可控入口" },
    { "id": "js-sink-exec", "lang": ["javascript", "typescript"], "kind": "sink", "category": "command-injection", "cwe": "CWE-78", "severity_hint": "high", "l1": true, "pattern": "(?:child_process\\.exec|(?<![\\w.$])exec)(?:Sync)?\\s*\\(", "note": "exec 走 shell；execFile / spawn 传数组才不过 shell。否定回顾断言用于排除 /re/.exec(str) 这类正则匹配调用" },
    { "id": "js-sink-spawn-shell", "lang": ["javascript", "typescript"], "kind": "sink", "category": "command-injection", "cwe": "CWE-78", "severity_hint": "high", "l1": true, "pattern": "(?:spawn|execFile)\\w*\\s*\\([^)]*shell\\s*:\\s*true", "note": "显式打开 shell，等同 exec" },
    { "id": "js-sink-eval", "lang": ["javascript", "typescript"], "kind": "sink", "category": "code-injection", "cwe": "CWE-94", "severity_hint": "critical", "l1": true, "pattern": "(?:^|[^\\w.$])eval\\s*\\(|new\\s+Function\\s*\\(|\\bvm\\.runIn\\w*\\s*\\(", "note": "动态求值" },
    { "id": "js-sink-innerhtml", "lang": ["javascript", "typescript"], "kind": "sink", "category": "xss", "cwe": "CWE-79", "severity_hint": "high", "l1": true, "pattern": "\\.(?:innerHTML|outerHTML)\\s*=|insertAdjacentHTML\\s*\\(|document\\.write(?:ln)?\\s*\\(", "note": "直接写 HTML，绕过框架转义" },
    { "id": "js-sink-react-dangerous", "lang": ["javascript", "typescript"], "kind": "sink", "category": "xss", "cwe": "CWE-79", "severity_hint": "high", "l1": true, "pattern": "dangerouslySetInnerHTML|\\bv-html\\b", "note": "框架里显式关掉转义的开口" },
    { "id": "js-sink-sql-template", "lang": ["javascript", "typescript"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "high", "l1": true, "pattern": "\\.(?:query|execute|raw|queryRawUnsafe|executeRawUnsafe)\\s*\\(\\s*`[^`]*\\$\\{", "note": "模板字符串插值进 SQL" },
    { "id": "js-sink-sql-concat", "lang": ["javascript", "typescript"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "high", "l1": false, "pattern": "\\.(?:query|execute|raw)\\s*\\(\\s*[\"'][^\"']*[\"']\\s*\\+", "note": "字符串拼接进 SQL" },
    { "id": "js-sink-nosql-where", "lang": ["javascript", "typescript"], "kind": "sink", "category": "nosql-injection", "cwe": "CWE-943", "severity_hint": "high", "l1": false, "pattern": "\\$where\\b|\\$function\\b|mapReduce\\s*\\(", "note": "MongoDB 服务端 JS 执行" },
    { "id": "js-sink-http", "lang": ["javascript", "typescript"], "kind": "sink", "category": "ssrf", "cwe": "CWE-918", "severity_hint": "medium", "l1": false, "pattern": "\\b(?:axios|got|superagent|undici)\\s*[\\.(]|\\bfetch\\s*\\(|https?\\.(?:get|request)\\s*\\(", "note": "服务端出网请求；浏览器侧 fetch 不算 SSRF" },
    { "id": "js-sink-fs", "lang": ["javascript", "typescript"], "kind": "sink", "category": "path-traversal", "cwe": "CWE-22", "severity_hint": "medium", "l1": false, "pattern": "\\bfs\\.(?:readFile|writeFile|createReadStream|createWriteStream|unlink|rm|readdir|appendFile|open)(?:Sync)?\\s*\\(", "note": "文件系统操作；看路径怎么来的" },
    { "id": "js-sink-sendfile", "lang": ["javascript", "typescript"], "kind": "sink", "category": "path-traversal", "cwe": "CWE-22", "severity_hint": "high", "l1": false, "pattern": "res\\.sendFile\\s*\\(|res\\.download\\s*\\(|express\\.static\\s*\\(", "note": "按路径回吐文件" },
    { "id": "js-sink-redirect", "lang": ["javascript", "typescript"], "kind": "sink", "category": "open-redirect", "cwe": "CWE-601", "severity_hint": "low", "l1": false, "pattern": "res\\.redirect\\s*\\(|location\\.(?:href|replace|assign)\\s*=?", "note": "跳转目标可控则为开放重定向" },
    { "id": "js-sink-proto-merge", "lang": ["javascript", "typescript"], "kind": "sink", "category": "prototype-pollution", "cwe": "CWE-1321", "severity_hint": "medium", "l1": false, "pattern": "\\b(?:_\\.)?(?:merge|mergeWith|defaultsDeep|extend|set)\\s*\\(|Object\\.assign\\s*\\(\\s*(?:\\{\\}|target)", "note": "递归合并外部对象可污染原型链" },
    { "id": "js-sink-jwt-noverify", "lang": ["javascript", "typescript"], "kind": "sink", "category": "auth-bypass", "cwe": "CWE-347", "severity_hint": "high", "l1": true, "pattern": "jwt\\.decode\\s*\\(|algorithms?\\s*:\\s*\\[?\\s*[\"']none[\"']", "note": "jwt.decode 不验签；algorithm none 等于不验签" },
    { "id": "js-cfg-tls-off", "lang": ["javascript", "typescript"], "kind": "config", "category": "insecure-tls", "cwe": "CWE-295", "severity_hint": "high", "l1": true, "pattern": "rejectUnauthorized\\s*:\\s*false|NODE_TLS_REJECT_UNAUTHORIZED\\s*[=:]\\s*[\"']?0", "note": "关闭 TLS 校验" },
    { "id": "js-cfg-cookie", "lang": ["javascript", "typescript"], "kind": "config", "category": "insecure-cookie", "cwe": "CWE-1004", "severity_hint": "low", "l1": false, "pattern": "httpOnly\\s*:\\s*false|secure\\s*:\\s*false|sameSite\\s*:\\s*[\"']none[\"']", "note": "会话 Cookie 保护位被关掉" },
    { "id": "js-sink-weak-crypto", "lang": ["javascript", "typescript"], "kind": "sink", "category": "weak-crypto", "cwe": "CWE-327", "severity_hint": "low", "l1": false, "pattern": "createHash\\s*\\(\\s*[\"'](?:md5|sha1)[\"']|\\bMath\\.random\\s*\\(", "note": "弱摘要 / 非密码学随机；用于安全场景才算问题" },
    { "id": "js-san", "lang": ["javascript", "typescript"], "kind": "sanitizer", "category": "", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\bDOMPurify\\.sanitize\\s*\\(|\\bescapeHtml\\s*\\(|\\bencodeURIComponent\\s*\\(|\\bexecFile\\w*\\s*\\(|shell-quote|path\\.resolve\\s*\\(|crypto\\.randomBytes\\s*\\(", "note": "安全替代实现" },

    { "id": "java-src-servlet", "lang": ["java", "kotlin"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\brequest\\.get(?:Parameter|ParameterValues|Header|Headers|Cookies|QueryString|InputStream|Reader|Part|RequestURI|PathInfo)\\s*\\(", "note": "Servlet 请求入口" },
    { "id": "java-src-spring-ann", "lang": ["java", "kotlin"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "@(?:RequestParam|PathVariable|RequestBody|RequestHeader|CookieValue|ModelAttribute|RequestPart|MatrixVariable)\\b", "note": "Spring MVC 参数绑定入口" },
    { "id": "java-src-bukkit", "lang": ["java", "kotlin"], "kind": "source", "category": "untrusted-input", "cwe": "", "severity_hint": "info", "l1": false, "pattern": "\\bargs\\s*\\[\\s*\\d+\\s*\\]|event\\.get(?:Message|Line|Name)\\s*\\(|\\bgetItemMeta\\(\\)\\.getDisplayName\\s*\\(", "note": "玩家可控输入（指令参数、聊天、物品名等）" },
    { "id": "java-sink-runtime-exec", "lang": ["java", "kotlin"], "kind": "sink", "category": "command-injection", "cwe": "CWE-78", "severity_hint": "high", "l1": true, "pattern": "Runtime\\.getRuntime\\s*\\(\\s*\\)\\s*\\.exec\\s*\\(|\\bProcessBuilder\\s*\\(", "note": "单字符串形式的 exec 会被拆词；ProcessBuilder 传数组则不过 shell" },
    { "id": "java-sink-sql-concat", "lang": ["java", "kotlin"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "high", "l1": true, "pattern": "\\.(?:executeQuery|executeUpdate|execute|createQuery|createNativeQuery|createSQLQuery)\\s*\\(\\s*[^)]*(?:\\+|\\$\\{|String\\.format)", "note": "SQL 拼接" },
    { "id": "java-sink-jdbctemplate", "lang": ["java", "kotlin"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "high", "l1": false, "pattern": "jdbcTemplate\\.(?:query|queryFor\\w+|update|execute|batchUpdate)\\s*\\(\\s*[^,)]*(?:\\+|\\$\\{|String\\.format)", "note": "Spring JdbcTemplate 里拼 SQL" },
    { "id": "java-sink-mybatis-dollar", "lang": ["java", "kotlin", "xml"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "high", "l1": false, "pattern": "\\$\\{[A-Za-z_][\\w.]*\\}", "note": "MyBatis ${} 是字符串替换不是绑定；#{} 才是绑定" },
    { "id": "java-sink-createstatement", "lang": ["java", "kotlin"], "kind": "sink", "category": "sql-injection", "cwe": "CWE-89", "severity_hint": "medium", "l1": false, "pattern": "\\.createStatement\\s*\\(", "note": "Statement 无绑定能力，SQL 必然是拼出来的" },
